# Copy to "inkdeus.local.toml" (git-ignored) for settings local to this machine.
# このPCだけの設定を書くファイル（git 管理外）。

# プロジェクトの置き場（既定は ~/inkdeus-projects。環境変数 INKDEUS_PROJECTS でも変えられる）
# projects_root = "~/inkdeus-projects"

# 漫画の構成（/manga/）の素材パネルに、全プロジェクト共通の素材ソースを足す（何個でも書ける）。
# mode: "panel" = コマにはめ込む画像 / "free" = ページ上へ自由に置く素材（擬音など）
# [[assets]]
# name = "擬音"
# path = "~/manga-assets/sfx"
# mode = "free"
# recursive = true

# 漫画の構成（/manga/）の文字で使うフォントを、このPCにあるフォントファイルから足す。
# フォントファイルは inkdeus には含まれません。自分で用意した物を指定し、各フォントのライセンスは自分で確かめてください。
# [fonts]
# dirs = ["~/fonts", "C:/Users/<ユーザー名>/AppData/Local/Microsoft/Windows/Fonts"]   # 複数可
# include = ["Example-Mincho.ttf", "ExampleSerif-*.otf"]    # ファイル名の glob。省略すると dirs 内の全フォント
# [fonts.names]                                             # 任意: ファイル名 → 表示名
# "Example-Mincho.ttf" = "例の明朝"

# 世代バックアップ: 設定・消しゴムとペン・部分マスクの手直し・漫画データ・プロジェクトの設定・スタイルを上書きする直前に、
# いまのファイルを <out>/.backup/ へ残す（inkdeus backup list / restore / prune。画面の「以前の状態に戻す…」）。
# [backup]
# enabled = true          # false で、退避しない
# keep_recent = 10        # 直近のこの個数は、間引かずに全部残す
# hourly_hours = 24       # それより古い物は「1 時間に 1 個」を、この時間ぶん
# daily_days = 30         # さらに古い物は「1 日に 1 個」を、この日数ぶん（それより古い物は消す）
# max_per_file = 200      # 1 ファイルあたりの個数の上限
# max_total_mb = 2048     # プロジェクト全体の上限（超えたら古い物から消す）

# 以前の版にあった `owner = true`（所有者モード）は廃止しました。書いてあっても無視されます。
# 透かしは画面の「透かしを入れる」スイッチ（設定JSON の watermark.enabled）で切り替えます。
